# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure your local settings.
# NEVER commit the real .env file or credentials to source control.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Storage & Lakehouse Local Paths
DATA_DIR=./data
RAW_DATA_PATH=./data/raw
SAMPLE_DATA_DIR=./data/sample
BRONZE_PATH=./data/bronze
SILVER_PATH=./data/silver
GOLD_PATH=./data/gold
QUARANTINE_PATH=./data/quarantine

# Apache Spark Configuration
SPARK_APP_NAME=OlistDeltaLakehouse
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g

# Delta Lake Configuration
DELTA_LOG_RETENTION_DURATION=interval 30 days
DELTA_DELETED_FILE_RETENTION_DURATION=interval 7 days

# Apache Airflow Configuration
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# SonarQube / SonarCloud (Used in CI/CD pipelines)
SONAR_TOKEN=your_sonarqube_token_here
SONAR_HOST_URL=https://sonarcloud.io
SONAR_ORGANIZATION=your_sonarcloud_organization
SONAR_PROJECT_KEY=data-engineering-platform-olist

# Kaggle API Credentials (Optional - for data download automation)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
